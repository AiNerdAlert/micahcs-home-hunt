const root = document.querySelector<HTMLElement>("[data-archive-root]");
if (root) {
	const storageKey = "micahs-index.youtube-completed.v1";
	const pageSize = 24;
	const cards = [...root.querySelectorAll<HTMLElement>("[data-video-card]")];
	const grid = root.querySelector<HTMLElement>("[data-video-grid]");
	const search = root.querySelector<HTMLInputElement>("[data-search]");
	const channel = root.querySelector<HTMLSelectElement>("[data-channel]");
	const sort = root.querySelector<HTMLSelectElement>("[data-sort]");
	const hideCompleted = root.querySelector<HTMLInputElement>("[data-hide-completed]");
	const matchCount = root.querySelector<HTMLElement>("[data-match-count]");
	const tagCount = root.querySelector<HTMLElement>("[data-tag-count]");
	const summary = root.querySelector<HTMLElement>("[data-filter-summary]");
	const empty = root.querySelector<HTMLElement>("[data-empty-state]");
	const loadMore = root.querySelector<HTMLButtonElement>("[data-load-more]");
	const categoryButtons = [...root.querySelectorAll<HTMLButtonElement>("button[data-category]")];
	const tagButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-tag]")];
	let selectedCategory = "all";
	let selectedTags = new Set<string>();
	let visibleLimit = pageSize;
	let completed = new Set<string>();
	try {
		completed = new Set(JSON.parse(localStorage.getItem(storageKey) ?? "[]"));
	} catch {
		completed = new Set();
	}
	const normalize = (value: string) => value.trim().toLocaleLowerCase();
	function syncCompletionUI() {
		for (const card of cards) {
			const id = card.dataset.id ?? "";
			const isComplete = completed.has(id);
			card.classList.toggle("is-complete", isComplete);
			const button = card.querySelector<HTMLButtonElement>("[data-complete]");
			const label = card.querySelector<HTMLElement>("[data-complete-label]");
			button?.setAttribute("aria-pressed", String(isComplete));
			if (label) label.textContent = isComplete ? "Completed" : "Mark complete";
		}
	}
	function updateUrl() {
		const params = new URLSearchParams();
		if (search?.value.trim()) params.set("q", search.value.trim());
		if (selectedCategory !== "all") params.set("category", selectedCategory);
		if (channel?.value) params.set("channel", channel.value);
		for (const tag of selectedTags) params.append("tag", tag);
		if (sort?.value && sort.value !== "archived-desc") params.set("sort", sort.value);
		const query = params.toString();
		history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
	}
	function cardSort(a: HTMLElement, b: HTMLElement) {
		const mode = sort?.value ?? "archived-desc";
		if (mode === "title-asc") return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
		const field = mode.startsWith("uploaded") ? "uploaded" : "archived";
		const direction = mode.endsWith("asc") ? 1 : -1;
		return (a.dataset[field] ?? "").localeCompare(b.dataset[field] ?? "") * direction;
	}
	function applyFilters(updateHistory = true) {
		const query = normalize(search?.value ?? "");
		const selectedChannel = channel?.value ?? "";
		const hideDone = hideCompleted?.checked ?? false;
		const matching = cards.filter((card) => {
			const tags = new Set((card.dataset.tags ?? "").split("|").filter(Boolean));
			const matchesQuery = !query || (card.dataset.searchText ?? "").includes(query);
			const matchesCategory = selectedCategory === "all" || card.dataset.category === selectedCategory;
			const matchesChannel = !selectedChannel || card.dataset.channel === selectedChannel;
			const matchesTags = [...selectedTags].every((tag) => tags.has(tag));
			const matchesCompletion = !hideDone || !completed.has(card.dataset.id ?? "");
			return matchesQuery && matchesCategory && matchesChannel && matchesTags && matchesCompletion;
		}).sort(cardSort);
		const matchingIds = new Set(matching.map((card) => card.dataset.id));
		for (const card of cards) card.hidden = true;
		matching.forEach((card, index) => {
			card.hidden = index >= visibleLimit;
			grid?.append(card);
		});
		const shown = Math.min(matching.length, visibleLimit);
		if (matchCount) matchCount.textContent = String(matching.length);
		if (tagCount) tagCount.textContent = String(selectedTags.size);
		if (summary) {
			summary.textContent = matching.length ? `Showing ${shown} of ${matching.length} matching video${matching.length === 1 ? "" : "s"}.` : "No videos match the current filters.";
		}
		if (empty) empty.hidden = matching.length > 0;
		if (loadMore) {
			const remaining = Math.max(0, matching.length - shown);
			loadMore.hidden = remaining === 0;
			loadMore.textContent = `Show ${Math.min(pageSize, remaining)} more`;
		}
		for (const card of cards) {
			if (!matchingIds.has(card.dataset.id)) card.hidden = true;
		}
		if (updateHistory) updateUrl();
	}
	function clearFilters() {
		if (search) search.value = "";
		if (channel) channel.value = "";
		if (sort) sort.value = "archived-desc";
		if (hideCompleted) hideCompleted.checked = false;
		selectedCategory = "all";
		selectedTags.clear();
		visibleLimit = pageSize;
		categoryButtons.forEach((button) => {
			const active = button.dataset.category === "all";
			button.classList.toggle("is-active", active);
			button.setAttribute("aria-pressed", String(active));
		});
		tagButtons.forEach((button) => button.setAttribute("aria-pressed", "false"));
		applyFilters();
	}
	function readUrl() {
		const params = new URLSearchParams(location.search);
		const category = params.get("category");
		if (categoryButtons.some((button) => button.dataset.category === category)) selectedCategory = category ?? "all";
		selectedTags = new Set(params.getAll("tag").filter((tag) => tagButtons.some((button) => button.dataset.tag === tag)));
		if (search) search.value = params.get("q") ?? "";
		if (channel && [...channel.options].some((option) => option.value === params.get("channel"))) channel.value = params.get("channel") ?? "";
		if (sort && [...sort.options].some((option) => option.value === params.get("sort"))) sort.value = params.get("sort") ?? "archived-desc";
		categoryButtons.forEach((button) => {
			const active = button.dataset.category === selectedCategory;
			button.classList.toggle("is-active", active);
			button.setAttribute("aria-pressed", String(active));
		});
		tagButtons.forEach((button) => button.setAttribute("aria-pressed", String(selectedTags.has(button.dataset.tag ?? ""))));
	}
	categoryButtons.forEach((button) => button.addEventListener("click", () => {
		selectedCategory = button.dataset.category ?? "all";
		visibleLimit = pageSize;
		categoryButtons.forEach((candidate) => {
			const active = candidate === button;
			candidate.classList.toggle("is-active", active);
			candidate.setAttribute("aria-pressed", String(active));
		});
		applyFilters();
	}));
	tagButtons.forEach((button) => button.addEventListener("click", () => {
		const tag = button.dataset.tag ?? "";
		if (selectedTags.has(tag)) selectedTags.delete(tag);
		else selectedTags.add(tag);
		button.setAttribute("aria-pressed", String(selectedTags.has(tag)));
		visibleLimit = pageSize;
		applyFilters();
	}));
	cards.forEach((card) => card.querySelector<HTMLButtonElement>("[data-complete]")?.addEventListener("click", () => {
		const id = card.dataset.id ?? "";
		if (completed.has(id)) completed.delete(id);
		else completed.add(id);
		localStorage.setItem(storageKey, JSON.stringify([...completed]));
		syncCompletionUI();
		applyFilters();
	}));
	search?.addEventListener("input", () => {
		visibleLimit = pageSize;
		applyFilters();
	});
	channel?.addEventListener("change", () => {
		visibleLimit = pageSize;
		applyFilters();
	});
	sort?.addEventListener("change", () => applyFilters());
	hideCompleted?.addEventListener("change", () => {
		visibleLimit = pageSize;
		applyFilters();
	});
	root.querySelector("[data-clear-filters]")?.addEventListener("click", clearFilters);
	root.querySelector("[data-empty-clear]")?.addEventListener("click", clearFilters);
	loadMore?.addEventListener("click", () => {
		visibleLimit += pageSize;
		applyFilters(false);
	});
	window.addEventListener("keydown", (event) => {
		const target = event.target as HTMLElement;
		if (event.key === "/" && ![
			"INPUT",
			"SELECT",
			"TEXTAREA"
		].includes(target.tagName)) {
			event.preventDefault();
			search?.focus();
		}
	});
	readUrl();
	syncCompletionUI();
	applyFilters(false);
}